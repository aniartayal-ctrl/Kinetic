{
  "name": "spineforge",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone 2D Mesh, Rigging, Weight-Painting & Animation Studio for Unity (Zero-Dependency C# Runtime + Spine 4.2 + Flipbook Sprite Sheet)",
  "scripts": {
    "dev": "next dev --port 3460",
    "build": "next build",
    "start": "next start --port 3460",
    "test": "tsx --test src/core/*.test.ts src/exporters/*.test.ts",
    "export:cli": "tsx src/cli/export.ts",
    "migrate:slotspy": "tsx src/cli/migrate-slotspy.ts",
    "verify:unity": "tsx src/cli/verify-unity.ts",
    "verify:all": "npm test && tsx src/cli/verify-unity.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "delaunator": "^5.0.1",
    "earcut": "^3.0.1",
    "gsap": "^3.15.0",
    "immer": "^10.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "maxrects-packer": "^2.7.3",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/delaunator": "^5.0.0",
    "@types/earcut": "^2.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.50.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
