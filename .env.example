# Copy to .env.local and fill in. .env.local is git-ignored; restart the server after editing.

# Claude (recommended). The copilot picks Claude automatically when this is set.
ANTHROPIC_API_KEY=
# Optional: claude-sonnet-5-5 (default), claude-opus-5-5 (strongest), claude-haiku-5-5 (fastest, cheapest)
KINETIC_CLAUDE_MODEL=

# Optional other providers
OPENAI_API_KEY=
KINETIC_OPENAI_MODEL=
XAI_API_KEY=
KINETIC_XAI_MODEL=

# Testing only: point Claude at the offline mock (npm run mock:anthropic)
# KINETIC_ANTHROPIC_BASE_URL=http://127.0.0.1:4599
